        <mxCell id="SeGLdGG_Htqy4wvZqLL3-127" value="&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Dựng kafka cluster gồm 2 node&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Tạo và thiết kế topic cho Order-Service pub ra và viết API cho Order-Service :&lt;br&gt;+Thanh toán khi nhận hàng&lt;br&gt;+Thanh toán trực tiếp : Cơ chế giữ đơn trong Inventory-Service, Tạo Payment-Service và nhận webhook từ bank&lt;br&gt;+Handle front-end cho suôn&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Tạo thiết kế topic cho Payment-Service và viết API cho Payment-Service:&lt;br&gt;+Thanh toán khi nhận hàng: Không phát message gì&lt;br&gt;+Thanh toán trực tiếp: Phát message PAYMENT_SUCCESSFUL&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Bắt đầu xử lý các message nhận trong các Service&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="3880" y="600" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="KVHHSvkqFgVwtm2dfVbM-1" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;-Sau 15 phút nếu order thanh toán qua online đó chưa thanh toán thì tiến hành xóa order đó và trả về số lượng&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;-Cập nhật lại swagger để tôi dễ dàng kiểm thử api&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;-Call cập nhật số lượng bên product-service&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="3530" y="945" width="1210" height="100" as="geometry" />
        </mxCell>
