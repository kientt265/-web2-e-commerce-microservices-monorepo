pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'ap-southeast-1'
        AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        // Mapping: ecr-repo-name=public-image-tag
        INFRA_IMAGES = "auth-db=postgres:15-alpine cart-db=redis:7.0-alpine delivery-db=postgres:15-alpine inventory-db=postgres:15-alpine order-db=postgres:15-alpine payment-db=postgres:15-alpine product-db=postgres:15-alpine rating-db=postgres:15-alpine kafka=confluentinc/cp-kafka:7.5.0 kafka-connect=debezium/connect:2.5 zookeeper=confluentinc/cp-zookeeper:7.5.0"
        CONFIG_REPO = 'e-commerce-gitops-config'
        GITHUB_USER = 'kientt265'
    }

    stages {
        stage('Mirror to ECR') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-ecr-creds', accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                    script {
                        sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                        def images = INFRA_IMAGES.split(' ')
                        for (img in images) {
                            def parts = img.split('=')
                            def ecrRepo = parts[0]
                            def publicImg = parts[1]
                            
                            echo "Processing: ${publicImg} -> ${ecrRepo}"
                            sh """
                                docker pull ${publicImg}
                                docker tag ${publicImg} ${ECR_REGISTRY}/${ecrRepo}:latest
                                docker push ${ECR_REGISTRY}/${ecrRepo}:latest
                                docker rmi ${publicImg} ${ECR_REGISTRY}/${ecrRepo}:latest || true
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy Infra via GitOps') {
            steps {
                withCredentials([[$class: 'UsernamePasswordMultiBinding', credentialsId: 'github-token-cred', usernameVariable: 'DUMMY_USER', passwordVariable: 'GITHUB_TOKEN']]) {
                    script {
                        echo "Triggering GitOps update for Infrastructure..."
                        // Trong thực tế, stage này sẽ cập nhật các file YAML trong thư mục /infrastructure của repo GitOps
                        // Để ArgoCD tự động sync các DB và Kafka
                        sh """
                            rm -rf ${CONFIG_REPO}
                            git clone https://${GITHUB_TOKEN}@github.com/${GITHUB_USER}/${CONFIG_REPO}.git
                            cd ${CONFIG_REPO}
                            
                            # Đảm bảo thư mục infrastructure tồn tại và có các manifest cơ bản
                            # Ở đây ta giả định các file YAML đã trỏ sẵn vào image :latest trên ECR
                            
                            git config user.email "jenkins-infra@example.com"
                            git config user.name "Jenkins Infra CI"
                            git commit --allow-empty -m "chore: trigger infra redeploy [skip ci]"
                            git push origin master
                        """
                    }
                }
            }
        }
    }
}
