pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }



    environment {
        AWS_REGION = 'ap-southeast-1'
        AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        SERVICES = "auth-service product-service order-service cart-service inventory-service delivery-service rating-service payment-service"
        GITHUB_USER = 'kientt265' 
        CONFIG_REPO = 'e-commerce-gitops-config'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Push') {
            when {
                anyOf {
                    branch 'refresh-code'
                }
            }
            steps {
                sh "docker system prune -f || true"
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-ecr-creds', accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'],
                    [$class: 'UsernamePasswordMultiBinding', credentialsId: 'github-token-cred', usernameVariable: 'DUMMY_USER', passwordVariable: 'GITHUB_TOKEN']
                ]) {
                    script {
                        def changedServices = []
                        for (service in SERVICES.split(' ')) {
                            def dir = "back/${service}"
                            def changed = sh(script: "git diff --name-only HEAD~1 HEAD | grep '^${dir}/' || true", returnStdout: true).trim()
                            if (changed) {
                                changedServices.add(service)
                            }
                        }

                        if (changedServices.isEmpty()) {
                            echo "No changes detected in services. Skipping build."
                        }

                        for (service in changedServices) {
                            def dir = "back/${service}"
                            def tag = "${BRANCH_NAME}-${BUILD_NUMBER}"
                            
                            echo "Building and pushing service: ${service} with tag: ${tag}"
                            sh """
                                cd ${dir}
                                aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                                docker build -t ${ECR_REGISTRY}/${service}:latest .
                                docker tag ${ECR_REGISTRY}/${service}:latest ${ECR_REGISTRY}/${service}:${tag}
                                docker push ${ECR_REGISTRY}/${service}:latest
                                docker push ${ECR_REGISTRY}/${service}:${tag}

                                # Dọn dẹp local images sau khi đã push thành công
                                docker rmi ${ECR_REGISTRY}/${service}:latest || true
                                docker rmi ${ECR_REGISTRY}/${service}:${tag} || true
                            """
                        }

                        if (!changedServices.isEmpty()) {
                            echo "Đang cập nhật image tags cho các service thay đổi trong repo ${CONFIG_REPO}..."
                            sh """
                                rm -rf ${CONFIG_REPO}
                                git clone https://${GITHUB_TOKEN}@github.com/${GITHUB_USER}/${CONFIG_REPO}.git
                                cd ${CONFIG_REPO}
                                
                                git config user.email "jenkins@example.com"
                                git config user.name "Jenkins CI"

                                for service in ${changedServices.join(' ')}; do
                                    tag="${BRANCH_NAME}-${BUILD_NUMBER}"
                                    echo "Cập nhật tag cho \${service} thành \${tag}"
                                    # Cập nhật tag image trong file YAML tương ứng
                                    sed -i "s|image: ${ECR_REGISTRY}/\${service}:.*|image: ${ECR_REGISTRY}/\${service}:\${tag}|g" services/\${service}.yaml
                                    git add services/\${service}.yaml
                                done
                                
                                git commit -m "chore: update services image tags to ${BRANCH_NAME}-${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"
                                git push origin master
                            """
                            
                            // Dọn dẹp image sau khi hoàn tất tất cả các service
                            sh "docker image prune -af || true"
                        }
                    }
                }
            }
        }
    }
}
