      "module": "module.eks",
      "mode": "data",
      "type": "aws_iam_policy_document",
      "name": "external_secrets_sa_assume_role_policy",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "128731714",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"oidc.eks.ap-southeast-1.amazonaws.com/id/2129B946A397C3C070A35CB9C8FF505C\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"https://oidc.eks.ap-southeast-1.amazonaws.com/id/2129B946A397C3C070A35CB9C8FF505C:sub\": \"system:serviceaccount:external-secrets:external-secrets\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Principal\":{\"Federated\":\"oidc.eks.ap-southeast-1.amazonaws.com/id/2129B946A397C3C070A35CB9C8FF505C\"},\"Condition\":{\"StringEquals\":{\"https://oidc.eks.ap-southeast-1.amazonaws.com/id/2129B946A397C3C070A35CB9C8FF505C:sub\":\"system:serviceaccount:external-secrets:external-secrets\"}}}]}",
            "override_json": null,
            "override_policy_documents": null,
